ARG RUNTIME_IMAGE=rpa-linux-xvfb:local
FROM ${RUNTIME_IMAGE}
LABEL org.datagrand.rpa.role="builder"
USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      rustc-1.89 cargo-1.89 build-essential pkg-config \
      libx11-dev libxtst-dev libxrandr-dev libxcb1-dev libdbus-1-dev \
      libxi-dev libxfixes-dev libxcb-randr0-dev libxcb-shm0-dev \
      libxcb-xfixes0-dev libxkbcommon-dev libxkbcommon-x11-dev \
 && rm -rf /var/lib/apt/lists/* \
 && install -d -m 0755 -o rpa -g rpa /work /home/rpa/.cargo
ENV RUSTC=/usr/bin/rustc-1.89 \
    RUSTDOC=/usr/bin/rustdoc-1.89 \
    CARGO_HOME=/home/rpa/.cargo \
    CARGO_NET_OFFLINE=true
USER 10001:10001
WORKDIR /work
HEALTHCHECK NONE
ENTRYPOINT []
CMD ["cargo-1.89", "build", "--locked", "--offline"]

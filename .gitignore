/target
# Nested workspace crate builds its own standalone target dir (the crate
# intentionally declares an empty [workspace] to stay self-contained).
/crates/native-input/target
**/*.rs.bk
.DS_Store

# Multi-agent run transcripts, captured screenshots, and per-run reports are
# sensitive / machine-generated and must never be committed. Only planning,
# contract, and review Markdown under .agents/ (CONTRACT.md, README.md,
# plans/, artifacts/ sources) stays tracked.
.agents/runs/
.agents/reports/
**/captures/

# Editor state
.cursor/

# Python helper caches
__pycache__/
**/__pycache__/
*.pyc

# Native acceptance-fixture build products (compiled by an independent
# worker); fixture source stays tracked, binaries/objects do not.
acceptance-fixture/build/

# Complied fixture binaries inside committed .app bundles are build products,
# not source; Info.plist and other bundle metadata stay tracked.
.agents/artifacts/**/*.app/Contents/MacOS/
